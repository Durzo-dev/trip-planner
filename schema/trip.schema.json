{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Durzo-dev/trip-planner/schema/trip.schema.json",
  "title": "Trip",
  "description": "A trip plan rendered by trip-planner. Content strings (titles, texts) are shown as written.",
  "type": "object",
  "required": ["id", "title", "timezone", "participants", "days"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Also the file name: public/trips/<id>.json" },
    "title": { "type": "string" },
    "tagline": { "type": "string" },
    "timezone": { "type": "string", "description": "IANA time zone, e.g. Europe/Paris" },
    "example": { "type": "boolean", "description": "Shows an EXAMPLE badge" },
    "theme": {
      "type": "object",
      "required": ["gradientStart", "gradientEnd", "accent"],
      "additionalProperties": false,
      "properties": {
        "gradientStart": { "$ref": "#/$defs/color" },
        "gradientEnd": { "$ref": "#/$defs/color" },
        "accent": { "$ref": "#/$defs/color" }
      }
    },
    "participants": { "type": "array", "items": { "type": "string" } },
    "meetingPoint": {
      "type": "object",
      "required": ["date", "time"],
      "additionalProperties": false,
      "properties": { "date": { "$ref": "#/$defs/date" }, "time": { "$ref": "#/$defs/time" } }
    },
    "mapDecor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "river": {
          "type": "object",
          "required": ["points"],
          "additionalProperties": false,
          "properties": {
            "label": { "type": "string" },
            "points": { "type": "array", "items": { "$ref": "#/$defs/latLng" }, "minItems": 2 }
          }
        }
      }
    },
    "days": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/day" } },
    "polls": { "type": "object", "additionalProperties": { "$ref": "#/$defs/poll" } }
  },
  "$defs": {
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "description": "Local time; hours before 06:00 belong to the previous evening" },
    "latLng": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 },
    "place": {
      "type": "object",
      "required": ["name", "lat", "lng", "address"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "address": { "type": "string" },
        "mapsUrl": { "type": "string", "format": "uri" }
      }
    },
    "altGroup": {
      "type": "object",
      "required": ["label", "links"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "note": { "type": "string" },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "url"],
            "additionalProperties": false,
            "properties": { "name": { "type": "string" }, "url": { "type": "string", "format": "uri" } }
          }
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "place": { "$ref": "#/$defs/place" },
        "title": { "type": "string" },
        "illustration": { "type": "string" },
        "text": { "type": "string" },
        "addressLine": { "type": "string" },
        "alternatives": { "type": "array", "items": { "$ref": "#/$defs/altGroup" } },
        "repeatLoserOf": { "type": "string", "description": "Poll key: reuse the option that lost that poll" }
      }
    },
    "item": {
      "type": "object",
      "required": ["start", "end", "title"],
      "additionalProperties": false,
      "properties": {
        "start": { "$ref": "#/$defs/time" },
        "end": { "$ref": "#/$defs/time" },
        "title": { "type": "string" },
        "tag": { "type": "string" },
        "tagStyle": { "enum": ["all", "optional"] },
        "illustration": { "enum": ["market", "belltower", "meal", "escape", "bubbleTea", "monument", "christmasMarket", "boardGames", "cocktail"] },
        "photo": { "type": "string", "format": "uri" },
        "text": { "type": "string" },
        "addressLine": { "type": "string" },
        "places": { "type": "array", "items": { "$ref": "#/$defs/place" } },
        "alternatives": { "type": "array", "items": { "$ref": "#/$defs/altGroup" } },
        "poll": { "type": "string" },
        "choices": { "type": "array", "items": { "$ref": "#/$defs/choice" } }
      }
    },
    "section": {
      "type": "object",
      "required": ["label", "items"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "note": { "type": "string" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } }
      }
    },
    "day": {
      "type": "object",
      "required": ["date", "sections"],
      "additionalProperties": false,
      "properties": {
        "date": { "$ref": "#/$defs/date" },
        "label": { "type": "string" },
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } }
      }
    },
    "poll": {
      "type": "object",
      "required": ["question", "options"],
      "additionalProperties": false,
      "properties": {
        "question": { "type": "string" },
        "default": { "type": "integer", "minimum": 0 },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["label", "voters"],
            "additionalProperties": false,
            "properties": { "label": { "type": "string" }, "voters": { "type": "array", "items": { "type": "string" } } }
          }
        }
      }
    }
  }
}

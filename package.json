{
  "name": "trip-planner",
  "version": "0.1.2",
  "private": true,
  "license": "CC-BY-NC-SA-4.0",
  "description": "Interactive, shareable trip plans for outings and holidays with friends: schedule, weather, map, polls.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup-hooks": "node tools/setup-hooks.mjs",
    "bump": "node tools/bump-version.mjs",
    "postinstall": "node tools/check-hooks.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
